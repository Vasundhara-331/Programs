
#include<stdlib.h>
#include<stdio.h>

 void lsearch(int a[], int n);
 void binsearch(int a[], int n);
  
  int main()
  {
    int n,i,ch;
    int a[100];
    int ans = 1;
    printf("Enter the number of elements of the array:");
    scanf("%d",&n);
    
    
    printf("\nEnter the elements of the array:");
    for(i=0;i<n;i++)
    {
      printf("\nEnter element:");
      scanf("%d",&a[i]);
    }
    
    printf("\nDisplaying the array:");
    for(i=0;i<n;i++)
    {
      printf("\t%d",a[i]);
    }
    
    do
    {
      printf("\nMenu:");
      printf("\n1. Linear Search");
      printf("\n2. Binary Search");
    
      printf("\nEnter the choice:");
      scanf("%d",&ch);
    
      if(ch == 1)
      lsearch(a,n);
      else if(ch == 2)
      binsearch(a,n);
      else
      printf("Invalid Choice, Try again");
      
      printf("\nWould you like to continue? Press 1:\n");
      scanf("%d",&ans);
    }
    while(ans == 1);
  }
    
    
 
    //Linear Search
    
    void lsearch(int a[], int n)
    {
      printf("\nLinear Search");
      int i,search,flag = 0;
      printf("\nEnter the search element:");
      scanf("%d",&search);
      for(i=0;i<n;i++)
      {
        if (a[i] == search)
        {
          flag = 1;
          break;
        }
      }
      if (flag == 1)
      {
        printf("Element found at position %d",i+1);
      }
      else
      {
        printf("Element not found!");
      }
    }
    
   //Binary Search 
    
    void binsearch(int a[], int n)
    {
      int i,j,t,flag=0,s;
 
      
      printf("\nBinary Search");
      for(i=0;i<n-1;i++)
      {
        for(j=0;j<n-i-1;j++)
        {
          if (a[j] > a[j+1])
          {
            t = a[j];
            a[j]= a[j+1];
            a[j+1] = t;
          }
        }
      }
      
      printf("\nEnter the search element:");
      scanf("%d",&s);
      
      int low=0,high=n-1,m;
      while(low <= high)
      {
        m = (low + high)/2;
        if (a[m] == s)
        {
          flag = 1;
          printf("\nElement found at position %d",m+1);
          break;
        }
        
        else if(a[m] < s)
        {
         low = m + 1;
        }
        
        else
        {
          high = m - 1;
        }
       }
      if(flag == 0)
      {
      printf("\nElement not found!");
      }
   }    
