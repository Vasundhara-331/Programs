#include <stdio.h>
#include <stdlib.h>

// Node structure
struct node {
    int data;
    struct node *link;
};

// Global pointers for Stack and Queue
struct node *stackTop = NULL;
struct node *queueFront = NULL;
struct node *queueRear = NULL;

// Stack operations
void push(int data) {
    struct node *newNode = (struct node *)malloc(sizeof(struct node));
    newNode->data = data;
    newNode->link = stackTop;
    stackTop = newNode;
    printf("Pushed: %d\n", data);
}

void pop() {
    if (stackTop == NULL) {
        printf("Stack Underflow!\n");
        return;
    }
    struct node *temp = stackTop;
    stackTop = stackTop->link;
    printf("Popped: %d\n", temp->data);
    free(temp);
}

void displayStack() {
    if (stackTop == NULL) {
        printf("Stack is empty!\n");
        return;
    }
    struct node *temp = stackTop;
    printf("Stack elements: ");
    while (temp != NULL) {
        printf("%d ", temp->data);
        temp = temp->link;
    }
    printf("\n");
}

// Queue operations
void enqueue(int data) {
    struct node *newNode = (struct node *)malloc(sizeof(struct node));
    newNode->data = data;
    newNode->link = NULL;

    if (queueRear == NULL) {
        queueFront = queueRear = newNode;
    } else {
        queueRear->link = newNode;
        queueRear = newNode;
    }
    printf("Enqueued: %d\n", data);
}

void dequeue() {
    if (queueFront == NULL) {
        printf("Queue Underflow!\n");
        return;
    }
    struct node *temp = queueFront;
    queueFront = queueFront->link;
    printf("Dequeued: %d\n", temp->data);
    free(temp);

    if (queueFront == NULL) {
        queueRear = NULL; // Reset rear if queue becomes empty
    }
}

void displayQueue() {
    if (queueFront == NULL) {
        printf("Queue is empty!\n");
        return;
    }
    struct node *temp = queueFront;
    printf("Queue elements: ");
    while (temp != NULL) {
        printf("%d ", temp->data);
        temp = temp->link;
    }
    printf("\n");
}
void sop(){
    int choice, data;
    while (1) {
    printf("\nChoose an operation:\n");
    printf("1. Push to Stack\n");
    printf("2. Pop from Stack\n");
    printf("3. Display Stack\n");
    printf("Enter your choice: ");
    scanf("%d", &choice);

        if (choice == 1) {
            printf("Enter data to push: ");
            scanf("%d", &data);
            push(data);
        } else if (choice == 2) {
            pop();
        } else if (choice == 3) {
            displayStack();
        }
         else {
            printf("Invalid choice! Please try again.\n");
        }
    }
}
void qop(){
    int choice, data;
    while (1) {
        printf("4. Enqueue to Queue\n");
        printf("5. Dequeue from Queue\n");
        printf("6. Display Queue\n");
        if (choice == 4) {
            printf("Enter data to enqueue: ");
            scanf("%d", &data);
            enqueue(data);
        } else if (choice == 5) {
            dequeue();
        } else if (choice == 6) {
            displayQueue();
        } else if (choice == 7) {
            exit(0);
        } else {
            printf("Invalid choice! Please try again.\n");
        }
    }
}
int main() {
    int choice, data;

    while (1) {
        printf("\nChoose an operation:\n");
        printf("1. Stack\n");
        printf("2. Queue\n");
        printf("3. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        if (choice == 1) {
            sop();
        } else if (choice == 2) {
           qop();
        } else if (choice == 3) {
            break;
        }
        else {
            printf("Invalid choice! Please try again.\n");
        }
    }

    return 0;
}
