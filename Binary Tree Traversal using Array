# include <stdio.h>
# include <stdlib.h>

void initializeTree(int tree[],int n) {
  for(int i = 0; i<n; i++) {
    tree[i] = -1;
  }
}
  
  void insertNode(int data,int index,int tree[],int n) {
    if(index >= n) {
     printf("\nPosition out of bounds");
   }
   if(tree[index] == -1) {
     tree[index] = data;
     printf("\n%d added to index %d",data,index);
     return;
   }
   else {
     printf("\nPosition already occupied!");
   }
 }
 
 void inorder(int tree[],int n,int index) {
   if(index >= n || tree[index] == -1) {
     return;
   }
   inorder(tree,n,2*index+1);
   printf("%d\t",tree[index]);
   inorder(tree,n,2*index+2);
 }
 
 void preorder(int tree[],int n,int index) {
   if(index >= n || tree[index] == -1) {
     return;
   }
   printf("%d\t",tree[index]);
   preorder(tree,n,2*index+1);
   preorder(tree,n,2*index+2);
 }
 
 void postorder(int tree[],int n,int index){
   if(index >= n || tree[index] == -1) {
     return;
   }
   postorder(tree,n,2*index+1);
   postorder(tree,n,2*index+2);
   printf("%d\t",tree[index]);
 }
 
 void levelorder(int tree[],int n) {
   for(int i = 0;i<n;i++) {
     if(tree[i] > 0) {
       printf("%d\t",tree[i]);
     }
   }
 }
 
 void display(int tree[], int n) {
   printf("\nBinary tree:");
   for(int i = 0; i<n; i++) {
     if(tree[i] != -1) {
       printf("\nElement : %d,  Index: %d",tree[i],i);
     }
   }
   return;
 }   
       
int main() {
  int n=100,choice,data,index;
  int tree[n];
  initializeTree(tree,n);
  while(1) {
  printf("\nDisplaying the Tree Menu:");
  printf("\n1. Insert a node");
  printf("\n2. Inorder Traversal");
  printf("\n3. Perorder Traversal");
  printf("\n4. Postorder Traversal");
  printf("\n5. Level Order Traversal");
  printf("\n6. Display Tree");
  printf("\n7. Exit");
  
  printf("\nEnter the choice: ");
  scanf("%d",&choice);
  
  switch(choice) {
    case 1: {
      printf("\nEnter the element to be inserted: ");
      scanf("%d",&data);
      printf("\nEnter the index: ");
      scanf("%d",&index);
      insertNode(data,index,tree,n);
      break;
    }
    case 2: {
      printf("\nInorder: ");
      inorder(tree,n,0);
      break;
    }
    case 3: {
      printf("\nPreorder: ");
      preorder(tree,n,0);
      break;
    }
    case 4: {
      printf("\nPostorder: ");
      postorder(tree,n,0);
      break;
    }
    case 5: {
      printf("\nLevel Order: ");
      levelorder(tree,n);
      break;
    }
    case 6: {
      display(tree,n);
      break;
    }
    case 7: {
      printf("\nExiting from the program!\n");
      exit(0);
      break;
    }
    default: {
      printf("\nInvalid Choice!");
    }
  }
 }
  return 0;
}
