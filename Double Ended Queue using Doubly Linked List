# include <stdio.h>
# include <stdlib.h>

struct node { 
  int data;
  struct node* prev;
  struct node *next;
};
 struct node* front = NULL; 
 struct node* rear = NULL;

void insertFront(int value) {
  struct node *newNode = (struct node*) malloc(sizeof(struct node));
  if(newNode == NULL) {
    printf("\nMemory Allocation Failed!");
    return;
  }
  else {
  newNode -> data = value;
  newNode -> prev = NULL;
  newNode -> next = front;
  if(front == NULL) {
    rear = newNode;
  }
  else {
    front -> prev = newNode;
  }
  front = newNode;
  printf("\n%d has been inserted at the front",value); 
  }
}

void insertRear(int value) {
  struct node *newNode = (struct node*) malloc(sizeof(struct node));
  if(newNode == NULL) {
    printf("\nMemory Allocation Failed!");
    return;
  }
  else {
  newNode -> data = value;
  newNode -> next = NULL;
  newNode -> prev = rear;
  if(rear == NULL) {
    front = newNode;
  }
  else {
    rear -> next = newNode;
  }
  rear = newNode;
  printf("\n%d has been inserted at the rear",value);
  }
}

void deleteFront() {
  if(front == NULL) {
    printf("\nDouble ended queue is empty!");
    return;
  }
  struct node *temp = front;
  front = front -> next;
  if(front == NULL) {
    rear = NULL;
  }
  else {
    front -> prev = NULL;
  }
  printf("\n%d has been dequeued from front",temp -> data);
  free(temp);
}

void deleteRear() {
  if(rear == NULL) {
    printf("\nDouble ended queue is empty!");
    return;
  }
  else {
  struct node *temp = rear;
  rear = rear -> prev;
  if(rear == NULL) {
    front = NULL;
  }
  else {
    rear -> next = NULL;
  }
  printf("\n%d has been dequeued from rear",temp -> data);
  free(temp);
  }
}

void displayQueue() {
  if(front == NULL) {
    printf("\nDouble ended queue is empty!");
  }
  else {
  struct node *temp = front;
  printf("\nDisplaying queue elements:");
  while(temp != NULL) {
    printf("%d\t",temp -> data);
    temp = temp -> next;
  }
 }
}
  
int main() {
  int choice, value;
  while(1) {
  printf("\nDisplaying Menu:");
  printf("\n1. Insert at Front");
  printf("\n2. Insert at Rear");
  printf("\n3. Delete from Front");
  printf("\n4. Delete from Rear");
  printf("\n5. Display Queue");
  printf("\n6. Exit");
  
  printf("\nEnter the choice: ");
  scanf("%d",&choice);
  
  switch(choice) { 
    case 1: {
      printf("Enter the value to be inserted:");
      scanf("%d",&value);
      insertFront(value);
      break;
    }
    case 2: {
      printf("Enter the value to be inserted:");
      scanf("%d",&value);
      insertRear(value);
      break;
    }
    case 3: {
      deleteFront();
      break;
    }
    case 4: {
      deleteRear();
      break;
    }
    case 5: {
      displayQueue();
      break;
    }
    case 6: {
      printf("Exiting program!");
      exit(0);
    }
    default: {
      printf("Invalid Choice!");
    }
  }
 }
  return 0;
}
